# Optional API protection. Leave unset for local/demo use.
CRACKXNET_API_KEY=
CRACKXNET_RATE_LIMIT_REQUESTS=60
CRACKXNET_RATE_LIMIT_WINDOW_SECONDS=60

# Dataset and detector configuration.
DEEPCB_DATA_ROOT=data/DeepPCB
CRACKXNET_MODEL_MODE=baseline
CRACKXNET_CHECKPOINT=outputs/trained/baseline/best.pth
CRACKXNET_HYBRID_CHECKPOINT=outputs/trained/hybrid/best.pth
CRACKXNET_DEVICE=auto
CRACKXNET_HYBRID_DEVICE=auto
CRACKXNET_CONFIDENCE=0.5
CRACKXNET_REPORT_CACHE_MAX_ENTRIES=100
